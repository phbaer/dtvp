{
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "python": ".venv/bin/python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "dtvp.main:app",
                "--reload"
            ],
            "jinja": true,
            "env": {
                "DTVP_SESSION_SECRET_KEY": "dtvp-dev-only-local-mock-stack-session-key",
                "DTVP_SESSION_ALLOW_DEV_KEY": "true"
            }
        }
    ]
}
