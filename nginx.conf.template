upstream dtvp_backend {
    server dtvp:8000;
    keepalive 64;
}

upstream dependency_track_api {
    server dtrack-apiserver:8080;
    keepalive 32;
}

upstream dependency_track_frontend {
    server dtrack-frontend:8080;
    keepalive 16;
}

server {
    listen 80;
    server_name localhost;
    keepalive_timeout 65;
    keepalive_requests 1000;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    # Proxy DTVP backend and SPA under the configured context path.
    location = ${DTVP_CONTEXT_PATH} {
        return 301 ${DTVP_CONTEXT_PATH}/;
    }

    # Event streams must reach clients immediately and stay unbuffered.
    location ~ ^${DTVP_CONTEXT_PATH}/api/tasks/[^/]+/events$ {
        proxy_pass http://dtvp_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        gzip off;
        add_header X-Accel-Buffering no always;
    }

    location ${DTVP_CONTEXT_PATH}/ {
        proxy_pass http://dtvp_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy Dependency-Track API requests to the apiserver.
    location /api/ {
        proxy_pass http://dependency_track_api/api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Route all other traffic to the Dependency-Track frontend.
    location / {
        proxy_pass http://dependency_track_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
