# Sole published DTVP image: CPython free-threaded with fail-closed validation.
ARG PYTHON_VERSION=3.15t
ARG UV_IMAGE=ghcr.io/astral-sh/uv:alpine3.23

FROM node:lts-alpine AS frontend-build

ARG BUILD_COMMIT=unknown
ENV VITE_BUILD_COMMIT=$BUILD_COMMIT

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci --include=optional

COPY frontend/ ./
COPY data/rescore_rules.json /app/data/rescore_rules.json
COPY dtvp/resources/ssvc /app/dtvp/resources/ssvc
RUN npm run build

FROM ${UV_IMAGE}

ARG BUILD_COMMIT=unknown
ARG BUILD_NUMBER=unknown
ARG PYTHON_VERSION
ENV DTVP_BUILD_COMMIT=$BUILD_COMMIT \
    DTVP_BUILD_NUMBER=$BUILD_NUMBER \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_MANAGED_PYTHON=1 \
    UV_PYTHON=$PYTHON_VERSION \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python

WORKDIR /app

RUN uv python install "$PYTHON_VERSION"

COPY pyproject.toml uv.lock ./
COPY alembic.ini ./

# Compile Psycopg's C implementation against the image's PostgreSQL client
# libraries, then remove build tools. Compose runs PostgreSQL 18 and uses
# matching logical backup utilities from the retained client package.
RUN apk add --no-cache --virtual .build-deps build-base postgresql18-dev \
    && apk add --no-cache postgresql18-client \
    && uv sync --python "$PYTHON_VERSION" --frozen --no-dev --extra postgres \
    && apk del .build-deps

COPY dtvp ./dtvp
COPY scripts/dtvp_storage.py ./scripts/dtvp_storage.py
COPY start.sh CHANGELOG.md ./
COPY sbom/dtvp-frontend-cyclonedx.json /app/sbom/dtvp-frontend-cyclonedx.json
COPY sbom/dtvp-backend-cyclonedx.json /app/sbom/dtvp-backend-cyclonedx.json
RUN chmod +x start.sh

# Load the native dependencies that DTVP uses and prove that none of them has
# re-enabled the GIL before publishing the image.
RUN DTVP_REQUIRE_FREE_THREADED=true /app/.venv/bin/python -c \
    "import _cffi_backend, cryptography.hazmat.bindings._rust, psycopg, pydantic_core; from dtvp.python_runtime_services import validate_python_runtime; validate_python_runtime()"

COPY --from=frontend-build /app/frontend/dist ./frontend/dist
RUN cp ./frontend/dist/index.html ./frontend/dist/index.html.template

EXPOSE 8000

CMD ["/app/start.sh"]
