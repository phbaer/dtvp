# Primary CPython free-threaded image. Dockerfile remains the explicitly tagged
# GIL-enabled fallback for rollback and platform compatibility.
ARG PYTHON_IMAGE=python:3.14-alpine@sha256:26730869004e2b9c4b9ad09cab8625e81d256d1ce97e72df5520e806b1709f92
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.31@sha256:ecd4de2f060c64bea0ff8ecb182ddf46ba3fcccdc8a60cfdbaf20d1a047d7437
ARG PYTHON_VERSION=3.14t

FROM ${UV_IMAGE} AS uv

FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS frontend-build

ARG BUILD_COMMIT=unknown
ENV VITE_BUILD_COMMIT=$BUILD_COMMIT

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN --mount=type=secret,id=ca-certs,target=/tmp/ca-certs.crt \
    if [ -s /tmp/ca-certs.crt ]; then \
        NODE_EXTRA_CA_CERTS=/tmp/ca-certs.crt npm ci --include=optional; \
    else \
        npm ci --include=optional; \
    fi

COPY frontend/ ./
COPY data/rescore_rules.json /app/data/rescore_rules.json
RUN npm run build

FROM ${PYTHON_IMAGE}

ARG BUILD_COMMIT=unknown
ARG BUILD_NUMBER=unknown
ARG PYTHON_VERSION
ENV DTVP_BUILD_COMMIT=$BUILD_COMMIT \
    DTVP_BUILD_NUMBER=$BUILD_NUMBER \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_MANAGED_PYTHON=1 \
    UV_SYSTEM_CERTS=true \
    UV_PYTHON=$PYTHON_VERSION \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

WORKDIR /app

# Optionally add a private CA to the runtime trust store for the free-threaded
# Python download and internal OIDC/integration HTTPS endpoints. BuildKit keeps
# the source bundle out of context.
RUN --mount=type=secret,id=ca-certs,target=/tmp/ca-certs.crt \
    if [ -s /tmp/ca-certs.crt ]; then \
        cat /tmp/ca-certs.crt >> /etc/ssl/certs/ca-certificates.crt; \
    fi

COPY --from=uv /uv /bin/uv

RUN uv python install "$PYTHON_VERSION"

COPY pyproject.toml uv.lock ./
RUN uv sync --python "$PYTHON_VERSION" --frozen --no-dev

COPY dtvp ./dtvp
COPY start.sh CHANGELOG.md ./
COPY sbom/dtvp-frontend-cyclonedx.json /app/sbom/dtvp-frontend-cyclonedx.json
COPY sbom/dtvp-backend-cyclonedx.json /app/sbom/dtvp-backend-cyclonedx.json
RUN chmod +x start.sh

# Load the native dependencies that DTVP uses and prove that none of them has
# re-enabled the GIL before publishing the image.
RUN DTVP_REQUIRE_FREE_THREADED=true /app/.venv/bin/python -c \
    "import _cffi_backend, cryptography.hazmat.bindings._rust, pydantic_core; from dtvp.python_runtime_services import validate_python_runtime; validate_python_runtime()"

COPY --from=frontend-build /app/frontend/dist ./frontend/dist
RUN cp ./frontend/dist/index.html ./frontend/dist/index.html.template

# Keep the image safe when it is run directly or through an image-only
# orchestrator that does not supply Compose's UID/GID override.
RUN addgroup -S -g 10001 dtvp \
    && adduser -S -D -H -u 10001 -G dtvp dtvp \
    && mkdir -p /app/data \
    && chown -R 10001:10001 /app/data
ENV HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER 10001:10001

EXPOSE 8000

CMD ["/app/start.sh"]
