{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dtvp:dump:1:manifest",
  "title": "dtvp.dump.manifest/1: the manifest of an instance dump",
  "type": "object",
  "properties": {
    "format": {
      "const": "dtvp.dump"
    },
    "format_version": {
      "const": 1
    },
    "format_minor": {
      "type": "integer",
      "minimum": 0
    },
    "required_features": {
      "type": "array",
      "items": {
        "enum": [
          "credentials",
          "evidence-supporting-material"
        ]
      },
      "uniqueItems": true
    },
    "dump_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "enum": [
        "manual",
        "scheduled"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "instance"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "dtvp": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "build_commit": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "build_commit"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "dependency_track_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dependency_track_url"
      ],
      "additionalProperties": false
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "migrations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "namespace",
                "version",
                "name",
                "checksum"
              ],
              "additionalProperties": false
            }
          },
          "snapshot_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_method": {
            "enum": [
              "vacuum-into",
              "backup-api",
              "absent"
            ]
          }
        },
        "required": [
          "name",
          "namespaces",
          "migrations",
          "snapshot_at",
          "snapshot_method"
        ],
        "additionalProperties": false
      }
