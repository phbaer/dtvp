      ]
    },
    "created_at": {
      "$ref": "urn:dtvp:dump:1:common#/$defs/timestamp"
    }
  },
  "required": [
    "revision_id",
    "key",
    "revision",
    "value",
    "origin",
    "author",
    "created_at"
