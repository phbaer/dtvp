# Production: set unique secrets; configure OIDC; register an administrator with CLI.
POSTGRES_PASSWORD=replace-with-a-strong-password
DTVP_DATABASE_URL=postgresql+psycopg://dtvp:replace-with-a-strong-password@db:5432/dtvp
DTVP_SESSION_SECRET=replace-with-at-least-32-random-characters
DTVP_PUBLIC_URL=http://127.0.0.1:8000
# Set false after native migration and consumer cutover; also set on the worker.
DTVP_LEGACY_REVIEW_ENABLED=true
DTVP_OIDC_ISSUER=
DTVP_OIDC_CLIENT_ID=
DTVP_OIDC_CLIENT_SECRET=
# External sources remain disabled until explicitly configured.
DTVP_PROVIDERS_ENABLED=[]
DTVP_DT_URL=
DTVP_DT_API_KEY=
DTVP_VSCORER_URL=

# Agentyzer is a separate service. Enable only after configuring the endpoint and
# binding each product to its repository name in Agentyzer's repos.yaml.
DTVP_AGENTYZER_ENABLED=false
DTVP_AGENTYZER_URL=
# Optional bearer credential for your Agentyzer gateway; never exposed to the UI.
DTVP_AGENTYZER_TOKEN=
DTVP_AGENTYZER_TIMEOUT_SECONDS=3600
