# DTVP environment example
#
# Copy to .env. Docker Compose passes every line to the DTVP container
# (env_file), and the backend also reads .env from its working directory
# for the Dependency-Track, login, tmrescore and analyzer settings.
# Uncommented lines must be set. Commented lines show the built-in default.
# Booleans accept true/false (most also accept 1/0, yes/no, on/off).

# ---------------------------------------------------------------------------
# Dependency-Track connection (required)
# ---------------------------------------------------------------------------
# Dependency-Track API base URL. Built-in default http://localhost:8081;
# compose.yml defaults to http://dtrack-apiserver:8080.
DTVP_DT_API_URL=http://dtrack-apiserver:8080
# Dependency-Track API key. "change_me" counts as not set.
DTVP_DT_API_KEY=replace-with-dependency-track-api-key
# File holding the API key; read only while DTVP_DT_API_KEY is "change_me".
# DTVP_DT_API_KEY_FILE=
# Older aliases, used only when the DTVP_DT_* values above are not set.
# DEPENDENCY_TRACK_URL=
# DEPENDENCY_TRACK_API_KEY=

# ---------------------------------------------------------------------------
# Login and public address (required)
# ---------------------------------------------------------------------------
# Public base URL of DTVP without the context path. Built-in default
# http://localhost:8000; compose.yml defaults to http://localhost/dtvp.
DTVP_FRONTEND_URL=https://dtvp.example.com
# Path DTVP is served under. Built-in default /; compose.yml defaults to /dtvp.
DTVP_CONTEXT_PATH=/dtvp
# Key that signs session cookies. Use a long random value; "change_me" is the
# insecure built-in default.
DTVP_SESSION_SECRET_KEY=replace-with-long-random-string
# OpenID Connect provider (issuer) URL.
DTVP_OIDC_AUTHORITY=https://login.example.com/realms/example
# OpenID Connect client ID.
DTVP_OIDC_CLIENT_ID=dtvp
# Client secret; only for confidential clients.
# DTVP_OIDC_CLIENT_SECRET=
# Login callback. Default: <DTVP_FRONTEND_URL><DTVP_CONTEXT_PATH>/auth/callback
# DTVP_OIDC_REDIRECT_URI=
# Older aliases, used only when the DTVP_OIDC_* values above are not set.
# ISSUER_URL=
# CLIENT_ID=
# Development only: skip login and treat every request as user "devuser".
# DTVP_DEV_DISABLE_AUTH=false
# Comma-separated CORS origins. When set, it REPLACES the built-in list
# (localhost:5173/8000, the frontend URL, the host name) in the application.
# DTVP_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Local database and data files (persistent: back up, do not clear)
# ---------------------------------------------------------------------------
# Data directory of the local database.
# DTVP_DT_CACHE_PATH=data/dt_cache
# The SQLite database: imported projects and findings, assessments with their
# fields and history, the export queue, access tokens.
# Default: <DTVP_DT_CACHE_PATH>/dtvp.sqlite3
# DTVP_DATABASE_PATH=
# Separate file for assessments and the export queue. Leave unset to keep them
# in the database. Default: DTVP_DATABASE_PATH
# DTVP_ASSESSMENT_OUTBOX_PATH=
# Stored grouped-view indexes. Default: grouped_vuln_summary_index.sqlite next
# to the DTVP_DT_CACHE_PATH directory.
# DTVP_GROUPED_VULN_SUMMARY_INDEX_PATH=
# Component-to-team mapping.
# TEAM_MAPPING_PATH=data/team_mapping.json
# Nested team groups.
# TEAM_GROUPS_PATH=data/team_groups.json
# User-to-role mapping (REVIEWER / ANALYST).
# USER_ROLES_PATH=data/user_roles.json
# CVSS rescoring rules.
# RESCORE_RULES_PATH=data/rescore_rules.json

# ---------------------------------------------------------------------------
# Import from and export to Dependency-Track
# ---------------------------------------------------------------------------
# auto: export assessments as they are saved. manual: keep them in DTVP until
# a reviewer exports them under Settings > Export.
# DTVP_EXPORT_MODE=auto
# Seconds between background refreshes (whole number, min 1).
# DTVP_DT_CACHE_REFRESH_SECONDS=60
# Seconds the cached project list is served without asking Dependency-Track
# (0 or more).
# DTVP_DT_PROJECT_LIST_TTL_SECONDS=30
# Seconds a project stays in the periodic refresh after its last use (min 60).
# DTVP_DT_ACTIVE_PROJECT_TTL_SECONDS=900
# Number of most recently used projects refreshed periodically (min 1).
# DTVP_DT_ACTIVE_PROJECT_LIMIT=8
# Decoded documents kept in memory (min 1).
# DTVP_DT_MEMORY_CACHE_MAX_ENTRIES=256
# Project-name queries kept in memory (min 1).
# DTVP_DT_PROJECT_QUERY_CACHE_MAX_ENTRIES=128
# Parallel exports to Dependency-Track in the background (min 1).
# DTVP_ASSESSMENT_SYNC_CONCURRENCY=4
# Parallel Dependency-Track assessment reads or writes per operation (min 1).
# DTVP_ASSESSMENT_IO_CONCURRENCY=4
# Attempts for an assessment write that times out or gets HTTP 429/5xx (min 1).
# DTVP_ASSESSMENT_WRITE_MAX_ATTEMPTS=3
# Read the finding from Dependency-Track before accepting a save and refuse
# the save if it changed there.
# DTVP_ASSESSMENT_STRICT_DT_CONFLICTS=false
# Parallel fetches of project versions (min 1).
# DTVP_VERSION_FETCH_CONCURRENCY=4

# ---------------------------------------------------------------------------
# CycloneDX export
# ---------------------------------------------------------------------------
# source.name of DTVP's own rating in a VDR. A request parameter overrides it.
# DTVP_CYCLONEDX_ASSESSMENT_SOURCE=DTVP
# Namespace of the properties in a VDR (letters, digits, ".", "_", "-").
# A request parameter overrides it.
# DTVP_CYCLONEDX_PROPERTY_PREFIX=dtvp
# DTVP_CYCLONEDX_TICKET_PREFIXES=AB,CD

# ---------------------------------------------------------------------------
# Access tokens, API keys and MCP
# ---------------------------------------------------------------------------
# Accept personal access tokens on /api (read-only, as Authorization: Bearer
# or X-Api-Key) and serve the MCP endpoint at <context path>/mcp.
# DTVP_ACCESS_TOKENS_ENABLED=false
# Separate file for token digests and the token audit log. Leave unset to keep
# them in the database. Default: DTVP_DATABASE_PATH
# DTVP_ACCESS_TOKENS_PATH=
# Fixed in the code, not configurable: a token lives at most 365 days, and a
# user can have at most 20 active tokens.

# ---------------------------------------------------------------------------
# User interface
# ---------------------------------------------------------------------------
# Project filter preselected on the dashboard.
# DTVP_DEFAULT_PROJECT_FILTER=
# Presets of the attribution-age filter.
# DTVP_ATTRIBUTION_AGE_FILTER_DAYS=7d,14d,28d
# Jira "create issue" URL offered in the UI. Empty hides the link.
# DTVP_JIRA_CREATE_URL=

# ---------------------------------------------------------------------------
# Grouped vulnerability views (tuning)
# ---------------------------------------------------------------------------
# Seconds a finished project load is kept (min 60).
# DTVP_GROUPED_VULN_TASK_TTL_SECONDS=900
# Finished project loads kept in memory (min 1).
# DTVP_GROUPED_VULN_TASK_MAX_RETAINED=24
# Stored summary indexes (min 1).
# DTVP_GROUPED_VULN_SUMMARY_INDEX_MAX_ENTRIES=64
# Worker threads for list queries (min 1) and queries waiting behind them.
# DTVP_GROUP_QUERY_WORKERS=4
# DTVP_GROUP_QUERY_MAX_PENDING=8
# Cached filter combinations per project load (min 1) and their size in bytes
# (min 1).
# DTVP_GROUP_QUERY_CACHE_ENTRIES=32
# DTVP_GROUP_QUERY_CACHE_BYTES=8388608
# Workers that build a project view (min 1) and builds waiting behind them.
# DTVP_GROUP_BUILD_WORKERS=2
# DTVP_GROUP_BUILD_MAX_PENDING=4
# Workers that plan automatic analysis after a load (min 1) and jobs waiting.
# DTVP_GROUP_POSTPROCESS_WORKERS=1
# DTVP_GROUP_POSTPROCESS_MAX_PENDING=2
# Workers that load a vulnerability's details (min 1) and jobs waiting.
# DTVP_GROUP_DETAIL_WORKERS=2
# DTVP_GROUP_DETAIL_MAX_PENDING=8

# ---------------------------------------------------------------------------
# SSVC and exploitation evidence
# ---------------------------------------------------------------------------
# Fetch exploitation evidence (for example the CISA KEV list) from the
# official sources over the internet. Accepts true/1/yes; anything else is off.
# DTVP_SSVC_ENRICHMENT_ENABLED=true
# Cache of that evidence. Default: <DTVP_DT_CACHE_PATH>/ssvc_enrichment.sqlite3
# DTVP_SSVC_CACHE_PATH=

# ---------------------------------------------------------------------------
# Threat-model rescoring (tmrescore); disabled while the URL is unset
# ---------------------------------------------------------------------------
# DTVP_TMRESCORE_URL=
# HTTP timeout in seconds.
# DTVP_TMRESCORE_TIMEOUT_SECONDS=180
# Cached proposals. Default: data/tmrescore_proposals.json in the working
# directory.
# DTVP_TMRESCORE_CACHE_PATH=
# Seconds a finished rescoring task is kept (min 60).
# DTVP_TMRESCORE_TASK_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Code analysis (Agentyzer); disabled while the URL is unset
# ---------------------------------------------------------------------------
# DTVP_CODE_ANALYSIS_URL=
# HTTP timeout in seconds for analysis requests.
# DTVP_CODE_ANALYSIS_TIMEOUT_SECONDS=300
# HTTP timeout in seconds for health and job-status requests (min 0.1).
# DTVP_CODE_ANALYSIS_STATUS_TIMEOUT_SECONDS=5
# Seconds the shared dashboard status is reused (min 1).
# DTVP_CODE_ANALYSIS_DASHBOARD_CACHE_SECONDS=3
# Hints passed to the analyzer; empty lets the analyzer decide.
# DTVP_CODE_ANALYSIS_MODEL=
# DTVP_CODE_ANALYSIS_LLM_BACKEND=
# DTVP_CODE_ANALYSIS_LLM_PROVIDER=
# Analyses DTVP runs at the same time (min 1).
# DTVP_ANALYSIS_QUEUE_CAPACITY=1
# Analyses that may wait; further requests get HTTP 429 (min 1).
# DTVP_ANALYSIS_QUEUE_MAX_PENDING=1000
# Seconds a finished queue entry is kept (min 60).
# DTVP_ANALYSIS_QUEUE_TTL_SECONDS=3600
# Store of analysis results. Default: data/code_analysis_results.sqlite in the
# working directory.
# DTVP_CODE_ANALYSIS_RESULTS_PATH=
# Results kept (min 1).
# DTVP_CODE_ANALYSIS_RESULTS_MAX_RECORDS=2000
# Maximum age of a result in days; 0 keeps them regardless of age.
# DTVP_CODE_ANALYSIS_RESULTS_RETENTION_DAYS=0
# Keep reviewer guidance with a result. Off with 0/false/no/off/disabled.
# DTVP_CODE_ANALYSIS_RESULTS_STORE_GUIDANCE=true
# Maximum age in days of a result reused for the same finding; 0 reuses by
# fingerprint only.
# DTVP_CODE_ANALYSIS_RESULT_FRESHNESS_DAYS=0
# Start analyses automatically.
# DTVP_AUTO_CODE_ANALYSIS_ENABLED=false
# Seconds between automatic sweeps (min 60).
# DTVP_AUTO_CODE_ANALYSIS_SWEEP_SECONDS=900
# Static per-component guidance for automatic analysis.
# DTVP_AUTO_ANALYSIS_GUIDANCE_PATH=data/auto_analysis_guidance.json

# ---------------------------------------------------------------------------
# Project archives
# ---------------------------------------------------------------------------
# ZIP archives, import previews and snapshots.
# DTVP_PROJECT_ARCHIVE_PATH=data/project_archives
# Also write archives as a directory tree suited to Git.
# DTVP_PROJECT_ARCHIVE_EXPANDED_ENABLED=false
# DTVP_PROJECT_ARCHIVE_EXPANDED_PATH=data/project_archives_git
# Take snapshots on a schedule.
# DTVP_PROJECT_ARCHIVE_SNAPSHOT_ENABLED=false
# Seconds between scheduled snapshots (min 60).
# DTVP_PROJECT_ARCHIVE_INTERVAL_SECONDS=86400
# ZIP archives kept per project (min 1).
# DTVP_PROJECT_ARCHIVE_RETENTION_COUNT=30
# Comma-separated project names for scheduled snapshots.
# DTVP_PROJECT_ARCHIVE_INCLUDE=

# ---------------------------------------------------------------------------
# Compose only (read by compose.yml, not by the application)
# ---------------------------------------------------------------------------
# Host port of the nginx container.
# DTVP_HTTP_PORT=80
# Build number baked into the image and printed at start.
# BUILD_NUMBER=unknown
# Archive Git helper (compose profile "archive-git"): pushes the expanded
# archive tree to a Git remote.
# DTVP_ARCHIVE_GIT_REMOTE=
# DTVP_ARCHIVE_GIT_BRANCH=main
# DTVP_ARCHIVE_GIT_AUTHOR_NAME=DTVP Archive Bot
# DTVP_ARCHIVE_GIT_AUTHOR_EMAIL=dtvp-archive@example.invalid
# DTVP_ARCHIVE_GIT_SSH_KEY_FILE=/ssh/dtvp_archive_deploy_key
# DTVP_ARCHIVE_GIT_KNOWN_HOSTS_FILE=/ssh/known_hosts

# ---------------------------------------------------------------------------
# Runtime (set by the container image and start script; rarely changed)
# ---------------------------------------------------------------------------
# Refuse to start unless Python runs without the GIL. compose.yml fixes this to
# true and compose.gil.yml to false, so a value here has no effect with them.
# Accepts 1/true/yes/on and 0/false/no/off; anything else stops the start.
# DTVP_REQUIRE_FREE_THREADED=false
# Keep-alive timeout in seconds of the backend's HTTP server (start.sh).
# DTVP_UVICORN_KEEP_ALIVE_SECONDS=30
# Application the boot wrapper loads. Leave alone.
# DTVP_BOOT_APP=dtvp.main:app
# Set while building the image (build arguments BUILD_COMMIT and BUILD_NUMBER);
# do not set here: DTVP_BUILD_COMMIT, DTVP_BUILD_NUMBER, VITE_BUILD_COMMIT.

# ---------------------------------------------------------------------------
# Frontend development and build only (not read by the deployed container)
# ---------------------------------------------------------------------------
# API base URL for the Vite dev server or a custom frontend build.
# VITE_DTVP_API_URL=
# The same fallback exists for VITE_DTVP_CONTEXT_PATH, VITE_DTVP_FRONTEND_URL,
# VITE_DTVP_DEV_DISABLE_AUTH, VITE_DTVP_DEFAULT_PROJECT_FILTER,
# VITE_DTVP_ATTRIBUTION_AGE_FILTER_DAYS and VITE_DTVP_JIRA_CREATE_URL.

# ---------------------------------------------------------------------------
# Removed: delete these lines if your file still has them
# ---------------------------------------------------------------------------
# DTVP_EXPORT_VERIFY_SOURCE  (removed in 2.0.0; has no effect)
